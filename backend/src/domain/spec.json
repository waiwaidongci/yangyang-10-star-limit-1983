{
  "organization": "屿镜天文观测站",
  "tagline": "先估算校准条件下能拍多暗，再安排目标曝光。",
  "source": "屿镜天文站 V 波段标准星场校准曝光记录（2026 年秋季模拟数据）",
  "record_name": "校准曝光",
  "algorithm": "按观测夜前向验证的极限星等模型比选",
  "formula": "比较历史中位数、原曝光秒数与 log₁₀(曝光秒数/60)，后两者各有单变量方案和加入天空面亮度、大气质量、视宁度的方案。按观测夜扩窗验证，以平均绝对误差排名。固定入选方案后评估最终留出夜，再用全部校准夜拟合排程。星等余量 = 预测极限星等 − 目标星等。",
  "decision_prompt": "按计划曝光及预计天况，目标能否达到 V 波段单帧 5σ 点源探测要求并留足余量？",
  "fields": [
    {
      "key": "exposure_code",
      "label": "校准曝光编号",
      "type": "text",
      "example": "YJ-V-261002-01",
      "help": "同一设备、V 波段和测光流程下，每帧校准曝光记录一次。"
    },
    {
      "key": "observed_on",
      "label": "观测夜起始日期",
      "type": "date",
      "example": "2026-10-02",
      "help": "跨午夜的曝光沿用当班起始日期。"
    },
    {
      "key": "exposure_seconds",
      "label": "单帧曝光时长（s）",
      "type": "number",
      "min": 1,
      "max": 3600,
      "example": 240
    },
    {
      "key": "sky_brightness",
      "label": "V 波段天空面亮度（mag/arcsec²）",
      "type": "number",
      "min": 14,
      "max": 24,
      "example": 20.8,
      "help": "数值越大表示天空越暗。"
    },
    {
      "key": "airmass",
      "label": "目标方向大气质量（无量纲）",
      "type": "number",
      "min": 1,
      "max": 4,
      "example": 1.3
    },
    {
      "key": "seeing_arcsec",
      "label": "视宁度 FWHM（角秒）",
      "type": "number",
      "min": 0.3,
      "max": 12,
      "example": 2
    },
    {
      "key": "limiting_mag",
      "label": "实测 V 波段 5σ 点源极限星等（mag）",
      "type": "number",
      "min": 5,
      "max": 30,
      "example": 21.25,
      "help": "填校准帧测光记录中达到信噪比 5 的点源星等。"
    }
  ],
  "parameters": [
    {
      "key": "holdout_nights",
      "label": "最终留出夜数（夜）",
      "type": "integer",
      "min": 1,
      "max": 30,
      "default": 5
    },
    {
      "key": "validation_nights",
      "label": "每折验证夜数（夜）",
      "type": "integer",
      "min": 1,
      "max": 10,
      "default": 2,
      "help": "共三折，第一折至少使用更早的六个观测夜训练。"
    },
    {
      "key": "plan_exposure_seconds",
      "label": "计划单帧曝光时长（s）",
      "type": "number",
      "min": 1,
      "max": 3600,
      "default": 240
    },
    {
      "key": "plan_sky_brightness",
      "label": "预计 V 波段天空面亮度（mag/arcsec²）",
      "type": "number",
      "min": 14,
      "max": 24,
      "default": 20.8
    },
    {
      "key": "plan_airmass",
      "label": "计划目标方向大气质量（无量纲）",
      "type": "number",
      "min": 1,
      "max": 4,
      "default": 1.3
    },
    {
      "key": "plan_seeing_arcsec",
      "label": "预计视宁度 FWHM（角秒）",
      "type": "number",
      "min": 0.3,
      "max": 12,
      "default": 2
    },
    {
      "key": "target_mag",
      "label": "计划目标 V 星等（mag）",
      "type": "number",
      "min": 5,
      "max": 30,
      "default": 20.5
    },
    {
      "key": "reserve_mag",
      "label": "排程预留余量（mag）",
      "type": "number",
      "min": 0,
      "max": 3,
      "default": 0.3,
      "help": "预测极限需至少比目标暗这么多才能直接排程。"
    }
  ]
}
